# Clerk publishable key (client-safe) — see client/src/main.jsx
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the backend API — see client/src/context/AppContext.jsx
VITE_BASE_URL=http://localhost:3000

# Currency symbol shown throughout the UI (e.g. $) — see client/src/pages/MyBookings.jsx
VITE_CURRENCY=$

# Base URL for TMDB poster/backdrop images — see client/src/context/AppContext.jsx
# w500 keeps posters/cast photos fast to load; use /original only if you need full resolution.
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
