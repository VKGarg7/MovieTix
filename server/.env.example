MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
TMDB_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_PASS=

# Logging (see server/configs/logger.js)
LOG_LEVEL=info

# Rate limiting for public (unauthenticated) endpoints — see server/middleware/rateLimit.js
# Window length and max requests per IP for general public GETs (show listing/details).
RATE_LIMIT_PUBLIC_WINDOW_MIN=1
RATE_LIMIT_PUBLIC_MAX=60
# Stricter limits for the seat-availability polling endpoint specifically.
RATE_LIMIT_SEATS_WINDOW_MIN=1
RATE_LIMIT_SEATS_MAX=30
# Comma-separated IPs to exempt from the above limiters (corporate NATs, known partners).
RATE_LIMIT_ALLOWLIST=
