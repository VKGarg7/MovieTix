# MongoDB connection string (database name "MovieTix" is appended automatically) — see server/configs/db.js
MONGODB_URI=

# Port the Express server listens on — see server/server.js
PORT=3000

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://yourapp.com) — see server/server.js
CORS_ORIGIN=

# Clerk publishable key — used by the Clerk SDK/middleware for auth
CLERK_PUBLISHABLE_KEY=

# Clerk secret key — used by the Clerk SDK/middleware for auth
CLERK_SECRET_KEY=

# Inngest event key for sending events — see server/inngest/index.js
INNGEST_EVENT_KEY=

# Inngest signing key for verifying incoming requests — see server/inngest/index.js
INNGEST_SIGNING_KEY=

# TMDB v4 read access token used to fetch movie data — see server/controllers/showController.js
TMDB_API_KEY=

# Stripe secret key for creating checkout sessions — see server/controllers/bookingController.js
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for verifying webhook payloads — see server/controllers/stripeWebhooks.js
STRIPE_WEBHOOK_SECRET=

# Gmail address and app password used to send booking confirmation emails — see server/configs/nodeMailer.js
GMAIL_USER=
GMAIL_PASS=

# Secret used to sign/verify concession pickup QR tokens (HMAC) — see server/utils/pickupToken.js
QR_TOKEN_SECRET=

# Logging (see server/configs/logger.js)
LOG_LEVEL=info

# Rate limiting for public (unauthenticated) endpoints — see server/middleware/rateLimit.js
# Window length and max requests per IP for general public GETs (show listing/details).
RATE_LIMIT_PUBLIC_WINDOW_MIN=1
RATE_LIMIT_PUBLIC_MAX=60
# Stricter limits for the seat-availability polling endpoint specifically.
RATE_LIMIT_SEATS_WINDOW_MIN=1
RATE_LIMIT_SEATS_MAX=30
# Comma-separated IPs to exempt from the above limiters (corporate NATs, known partners).
RATE_LIMIT_ALLOWLIST=
